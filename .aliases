# ----------------------------------------------------------------------
# Others

# list all aliases and functions defined in this file, with descriptions
al() {
    local alias_color="$LIGHTCYAN" func_color="$LIGHTGREEN"
    printf '%b%s%b  %b%s%b\n\n' "$alias_color" "alias" "$NOCOLOR" "$func_color" "function" "$NOCOLOR"
    {
        # aliases: "name=value" -> name<TAB>alias<TAB>line
        alias | awk '{ i = index($0, "="); print substr($0, 1, i - 1) "\talias\t" $0 }'
        # functions: "name -- comment" -> name<TAB>function<TAB>line
        awk '
            /^#[[:space:]]*-+[[:space:]]*$/ { comment=""; next }
            /^#/ {
                c = $0
                sub(/^#[ \t]*/, "", c)
                comment = c
                next
            }
            /^[a-zA-Z_-]+\(\)/ {
                name = $0
                sub(/\(\).*/, "", name)
                if (comment != "") print name " -- " comment
                else print name
                comment = ""
                next
            }
            { comment = "" }
        ' ~/dotfiles-gmddk/.aliases | awk '{ n = $0; sub(/ -- .*/, "", n); print n "\tfunction\t" $0 }'
    } | sort -f -t $'\t' -k1,1 | while IFS=$'\t' read -r name kind line; do
        if [[ $kind == alias ]]; then
            printf '%b%s%b\n' "$alias_color" "$line" "$NOCOLOR"
        else
            printf '%b%s%b\n' "$func_color" "$line" "$NOCOLOR"
        fi
    done
}

# ----------------------------------------------------------------------
# Prompt (starship)
# El prompt muestra " — 🔄 (N)" donde N es el número de
# apps de la lista de brew-apps con actualizaciones
# Lo calcula ~/.local/bin/brew-outdated-count; se recalcula solo cada hora y al final de brew-apps.
# Recalcula ahora el contador de actualizaciones del prompt
alias brew-refresh="brew-outdated-count --refresh"

# open ~/.zshrc in Zed
alias ec="zed ~/.zshrc"

# source ~/.zshrc
alias sc="source ~/.zshrc"

# Run in a window - kill it with "Ctrl+C"
# alias proton="INTERVALO=300 node ~/dotfiles-gmddk/proton/proton_watch.mjs"

# Messages send it to a log file to be checked
# alias proton="INTERVALO=300 nohup node ~/dotfiles-gmddk/proton/proton_watch.mjs > ~/dotfiles-gmddk/proton/proton_watch.log 2>&1 &"

# Run on background
alias proton="INTERVALO=300 nohup node ~/dotfiles-gmddk/proton/proton_watch.mjs > /dev/null 2>&1 &"

# To kill it when running on background
alias protonkill="pkill -f proton_watch.mjs"

# To check if the process is running or does it not
# alias protoncheck="pgrep -fl proton_watch.mjs || echo 'Not running'"
alias protoncheck="pgrep -f 'proton_watch.mjs|proton-perfil' >/dev/null && echo 'Running' || echo 'Not running'"
