# ----------------------------------------------------------------------
# Aliases and functions
# ----------------------------------------------------------------------

alias ..="cd .."
alias cls=clear          # Clear your terminal screen

# Colores de ls -G (macOS). El primer par es el de las carpetas: "Dx" = amarillo en negrita
# (antes "ex" = azul, que se confundía con el fondo). El resto son los valores por defecto.
export LSCOLORS="Dxfxcxdxbxegedabagacad"

alias lsl="ls -lh -G"     # List all files in current directory, with readable sizes (4.2K, 1.3M)
alias lsla="ls -lah -G"   # List all files and directories, included hidden, with readable sizes
alias lsd="ls -ld -G */"    # List all directories in current directory in long list format
alias lsdh="ls -ld -G .*/ */"    # List all directories in current directory in long list format, included hidden

# list all files/directories starting with the given prefix, e.g. lss doc
lss() {
    [[ -z "$1" ]] && { echo "Usage: lss <prefix>"; return 1; }
    local -a matches=( "$1"*(N) )
    if (( ${#matches} == 0 )); then
        echo "Nothing starts with '$1' here"
        return 1
    fi
    echo "${YELLOW}ls -ldh -G $1*${NOCOLOR}"
    ls -ldh -G "${matches[@]}"
}

# List repos with current branch: ↑ = local changes not on remote, ↓ = remote has commits you don't have
# Use `lslb -f` to fetch every repo first (in parallel) so ↓ is up to date
lsbranchs() {
  local fetch=0 d b mark counts ahead behind
  [[ $1 == -f ]] && fetch=1
  if (( fetch )); then
    setopt local_options no_monitor no_notify
    for d in */; do [[ -e $d/.git ]] && git -C "$d" fetch -q 2>/dev/null & done
    wait
  fi
  for d in */; do
    d=${d%/}
    [[ -e $d/.git ]] || { printf "%s\n" "$d"; continue; }
    b=$(git -C "$d" branch --show-current 2>/dev/null)
    [[ -z $b ]] && b="detached@$(git -C "$d" rev-parse --short HEAD 2>/dev/null)"
    ahead=0; behind=0; mark=""
    counts=$(git -C "$d" rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null) && read -r ahead behind <<< "$counts"
    [[ -n $(git -C "$d" status --porcelain 2>/dev/null) || $ahead -gt 0 ]] && mark+=" ↑"
    (( behind > 0 )) && mark+=" ↓"
    printf "\e[1;34m%-22s\e[0m \e[33m%s\e[31m%s\e[0m\n" "$d" "$b" "$mark"
  done
}

# ----------------------------------------------------------------------
# Routes

# cd into a project folder under ~/Documents/Gameaddik
cdg() {
    cd ~/Documents/Gameaddik/"$1"
}

# cd into a repo folder under ~/Documents/Gameaddik/Repos
cdgr() {
    cd ~/Documents/Gameaddik/Repos/"$1"
}

# Tab completion: cdg/cdgr suggest the folders inside their base directory
if (( $+functions[compdef] )); then
    _cdg_complete()  { _path_files -/ -W ~/Documents/Gameaddik }
    _cdgr_complete() { _path_files -/ -W ~/Documents/Gameaddik/Repos }
    compdef _cdg_complete cdg
    compdef _cdgr_complete cdgr
fi


alias cathosts="cat /etc/hosts"
alias vihosts="sudo vi /etc/hosts"

