# ----------------------------------------------------------------------
# Docker

#docker compose ps --service

alias d-c="docker compose"

# stop and remove containers from docker-compose
d-cdown() {
    echo "${YELLOW}docker compose down${NOCOLOR}"
    docker compose down
}

# start containers from docker-compose in detached mode
d-cup() {
    echo "${YELLOW}docker compose up -d${NOCOLOR}"
    docker compose up -d
}

# remove unused docker data (stopped containers, dangling images, networks)
d-prune() {
    echo "${YELLOW}docker system prune -f${NOCOLOR}"
    docker system prune -f
}

# list running containers
d-ps() {
    echo "${YELLOW}docker ps${NOCOLOR}"
    docker ps
}

# shortcut for any docker command, e.g. d ps -a
d() {
    echo "${YELLOW}docker $@${NOCOLOR}"
    docker "$@"
}

# ----------------------------------------------------------------------
# GIT

# show working tree status
gs() {
    echo "${YELLOW}git status${NOCOLOR}"
    git status
}

# stage files, e.g. ga file1 file2
ga() {
    echo "${YELLOW}git add $@${NOCOLOR}"
    git add "$@"
}

# stage all changes
gaa() {
    echo "${YELLOW}git add -A${NOCOLOR}"
    git add -A
}

# list local branches
gb() {
    cls
    echo "${YELLOW}git branch${NOCOLOR}"
    git branch
}

#list both local and remote branches
gba() {
    cls
    echo "${YELLOW}git branch -a${NOCOLOR}"
    git branch -a
}

#list only remote branches
gbr() {
    cls
    echo "${YELLOW}git branch -r${NOCOLOR}"
    git branch -r
}

# checkout the given branch, e.g. gco main or gco -b new-branch
gco() {
    echo "${YELLOW}git checkout $*${NOCOLOR}"
    git checkout "$@"
}

#list the commits waiting to be pushed
gcherry() {
    echo "${YELLOW}git cherry -v${NOCOLOR}"
    git cherry -v
}

# commit staged changes, e.g. gc -m "message"
gc() {
    echo "${YELLOW}git commit $*${NOCOLOR}"
    git commit "$@"
}

# show unstaged changes
gd() {
    echo "${YELLOW}git diff${NOCOLOR}"
    git diff
}

# show diff stats between staged changes and origin's current branch
gdiff() {
    echo "${YELLOW}git diff --stat --cached origin/`git branch --show-current`${NOCOLOR}"
    git diff --stat --cached origin/`git branch --show-current`
}

# fetch changes from remote
gf() {
    cls
    echo "${YELLOW}git fetch${NOCOLOR}"
    git fetch
}

# show commit log, one line per commit
gl() {
    cls
    echo "${YELLOW}git log --oneline${NOCOLOR}"
    git log --oneline
}

# show commit log as a graph, with all branches
glol() {
    cls
    echo "${YELLOW}git log --oneline --graph --decorate --all${NOCOLOR}"
    git log --oneline --graph --decorate --all
}

# pull from remote
gp() {
    echo "${YELLOW}git pull${NOCOLOR}"
    git pull
}

# push to remote
gpush() {
    echo "${YELLOW}git push${NOCOLOR}"
    git push
}

# undo the last commit but keep the changes staged
gundo() {
    echo "${YELLOW}git reset --soft HEAD~1${NOCOLOR}"
    git reset --soft HEAD~1
}



# Tab completion: the functions that take arguments complete like their git command
# (gco <Tab> suggests branches, ga <Tab> modified files, gc <Tab> commit options)
if (( $+functions[compdef] )); then
    compdef _git ga=git-add
    compdef _git gco=git-checkout
    compdef _git gc=git-commit
fi

# forget to create a new branch, and made all your changes in the wrong branch?
# Moves all your changes to your newly created branch.
# git switch -c "new_branch"


# ----------------------------------------------------------------------
# Terminal tab customization (iTerm2)

# uses OSC 6, a native iTerm2 feature: it only colors the tab bar, never the terminal content background
# helper for tabcolor: sets the current tab color from a hex code, e.g. _iterm_set_tab_color "#2d4159"
_iterm_set_tab_color() {
    local hex="${1#\#}"
    local r=$((16#${hex:0:2}))
    local g=$((16#${hex:2:2}))
    local b=$((16#${hex:4:2}))
    printf '\033]6;1;bg;red;brightness;%d\007' "$r"
    printf '\033]6;1;bg;green;brightness;%d\007' "$g"
    printf '\033]6;1;bg;blue;brightness;%d\007' "$b"
}

# curated palette of eye-friendly colors, usable by name in tabcolor/tabcolors
typeset -a TABCOLOR_NAMES=(
    "blue1" "green1" "red1" "yellow1" "purple1" "orange1" "cyan1" "gray1"
)
typeset -A TABCOLOR_PALETTE=(
    "blue1"   "#2d4159"
    "green1"  "#33513c"
    "red1"    "#5c3535"
    "yellow1" "#5c4d2d"
    "purple1" "#3d3157"
    "orange1" "#5c4433"
    "cyan1"   "#2d5c56"
    "gray1"   "#3b4252"
)
typeset -A TABCOLOR_LABELS=(
    "blue1"   "Azul suave"
    "green1"  "Verde suave"
    "red1"    "Rojo suave"
    "yellow1" "Amarillo mostaza"
    "purple1" "Morado suave"
    "orange1" "Naranja suave"
    "cyan1"   "Cyan suave"
    "gray1"   "Gris azulado"
)

# preview the curated palette rendered with its real color: swatch, full name, hex, short name
tabcolors() {
    local name label hex r g b
    for name in "${TABCOLOR_NAMES[@]}"; do
        hex="${TABCOLOR_PALETTE[$name]}"
        label="${TABCOLOR_LABELS[$name]}"
        r=$((16#${hex:1:2}))
        g=$((16#${hex:3:2}))
        b=$((16#${hex:5:2}))
        printf "\e[48;2;%d;%d;%dm    \e[0m  %-18s %-10s %s\n" "$r" "$g" "$b" "$label" "$hex" "$name"
    done
}

# in iTerm2 it uses the native OSC 6 tab color; in other terminals it changes the background
# set the current tab's color by palette name or hex, e.g. tabcolor blue1 or tabcolor "#1e3a5f"
tabcolor() {
    local input="${(L)*}"
    local hex="${TABCOLOR_PALETTE[$input]:-$*}"
    if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
        _iterm_set_tab_color "$hex"
    else
        echo -ne "\e]11;$hex\a"
    fi
}

# reset the current tab's background color to the config default
tabcolorreset() {
    if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
        printf '\033]6;1;bg;*;default\007'
    else
        echo -ne "\e]111\a"
    fi
}

# set the current tab's title, e.g. tabtitle "my project"
tabtitle() {
    echo -ne "\e]0;$1\a"
}


# ----------------------------------------------------------------------
# Brew

# update Homebrew, upgrade all formulas (not casks) and clean up old versions
alias brew-formulas='brew update && brew upgrade --formula && brew cleanup'

# check the apps in the list for updates and ask app by app which ones to upgrade (a = all)
brew-apps() {
  local apps=(
    beyond-compare
    brave-browser
    claude
    dbeaver-community
    figma
    github
    gitkraken
    hammerspoon
    iterm2
    mongodb-compass
    notion
    obsidian
    postman
    slack
    visual-studio-code
    zed
  )
  brew update --quiet >/dev/null 2>&1

  local -a lines approved
  lines=("${(@f)$(brew outdated --cask --greedy --verbose "${apps[@]}")}")
  lines=("${lines[@]:#}")

  if (( ${#lines} == 0 )); then
    echo "Everything is up to date."
    return 0
  fi

  echo "Updates available (${#lines}):"
  echo
  local line app answer all=0
  for line in "${lines[@]}"; do
    app=${line%% *}
    echo "$line"
    if (( all )); then
      approved+=("$app")
      continue
    fi
    read -k 1 "answer?Update $app? [y/N/a=all/q=quit] "
    echo
    case "$answer" in
      y|Y) approved+=("$app") ;;
      a|A) approved+=("$app"); all=1 ;;
      q|Q) break ;;
    esac
  done

  if (( ${#approved} == 0 )); then
    echo
    echo "Nothing selected. No changes made."
    return 0
  fi

  echo
  echo "Updating: ${approved[*]}"
  HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications" brew upgrade --cask --greedy "${approved[@]}"
  local rc=$?

  # Recalcula el contador de actualizaciones del prompt (starship custom.brew)
  brew-outdated-count --refresh
  return $rc
}


